SECRET_KEY=replace-this-with-a-long-random-secret
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=put-your-mysql-root-password-here
DB_NAME=attendance_db
DB_SSL_CA=
FLASK_DEBUG=true

# Optional email alerts: Resend API is recommended for Render
RESEND_API_KEY=
RESEND_FROM=

# Free personal Gmail option for Render: deploy google_apps_script_email.gs as a web app
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_TOKEN=

# Optional local SMTP fallback (Gmail: use an App Password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
