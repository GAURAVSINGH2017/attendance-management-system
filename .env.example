SECRET_KEY=replace-this-with-a-long-random-secret
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=put-your-mysql-root-password-here
DB_NAME=attendance_db
DB_SSL_CA=
FLASK_DEBUG=true

# Optional email alerts (Gmail: use an App Password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Optional SMS alerts (Traccar Android SMS Gateway; SIM plan/carrier rules apply)
TRACCAR_SMS_URL=https://www.traccar.org/sms/
TRACCAR_SMS_TOKEN=

# Optional alternative SMS provider (Twilio; messages are billable)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
